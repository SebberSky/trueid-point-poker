PORT=3002
JIRA_BASE_URL=https://truedmp.atlassian.net
# Default until a room host API token is saved (admin). Room host token overrides for that room.
JIRA_EMAIL=
JIRA_API_TOKEN=
ADMIN_PATH=room-hosts-ctrl
ADMIN_LOGIN_USERNAME=
ADMIN_LOGIN_PASSWORD=
# Optional 64-char hex override for AES master key. Prefer macOS Keychain
# (service=trueid-point-poker, account=host-master-key) created automatically on first save.
# TIPP_MASTER_KEY=
# Set true behind HTTPS (Tailscale Funnel) so the session cookie gets the Secure flag.
# COOKIE_SECURE=true
