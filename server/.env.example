PORT=3002
JIRA_BASE_URL=https://truedmp.atlassian.net
# Default until a room host API token is saved (admin). Room host token overrides for that room.
JIRA_EMAIL=
JIRA_API_TOKEN=
ADMIN_PATH=room-hosts-ctrl
ADMIN_LOGIN_USERNAME=
ADMIN_LOGIN_PASSWORD=
# Optional 64-char hex override for AES master key. Prefer macOS Keychain
# (service=trueid-point-poker, account=host-master-key) created automatically on first save.
# TIPP_MASTER_KEY=
# Set true behind HTTPS (Tailscale Funnel) so the session cookie gets the Secure flag.
COOKIE_SECURE=true
# Login with Atlassian (OAuth 2.0 3LO) — create app at https://developer.atlassian.com/console/myapps/
# Callback must match exactly. Permissions: User Identity API → read:me ; Jira API → read:jira-user
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_REDIRECT_URI=https://agent3s-imac.taildc5084.ts.net/poker/api/auth/atlassian/callback
APP_PUBLIC_URL=https://agent3s-imac.taildc5084.ts.net/poker/
# Emergency fallback (off by default): POST /api/auth/login with email + API token
# ALLOW_API_TOKEN_LOGIN=true
